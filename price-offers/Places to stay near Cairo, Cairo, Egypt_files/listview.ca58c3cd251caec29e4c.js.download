  ${({size:e})=>et`
      // Almost all ANTD styles relating to the input checkbox are overwritten here.

      // Default State
      .ant-checkbox-inner {
        width: ${w0[e]+"px"};
        height: ${w0[e]+"px"};
        background-color: ${Te.gray25};
        outline: 1px solid ${Te.gray400};
        border: none;
        border-radius: 4px;
      }

      .ant-checkbox-checked .ant-checkbox-inner {
        border-radius: 4px;
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
      }

      .ant-checkbox-checked::after {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
        border-radius: 4px;
        visibility: hidden;
        -webkit-animation: antCheckboxEffect 0.36s ease-in-out;
        animation: antCheckboxEffect 0.36s ease-in-out;
        -webkit-animation-fill-mode: backwards;
        animation-fill-mode: backwards;
      }

      .ant-checkbox-checked .ant-checkbox-inner::after {
        border-color: ${({theme:t})=>t.backgroundColor}; // The ANTD checkbox is just a rectangle turned 45deg with two borders.
        width: ${+w0[e]/3}px;
        height: ${+w0[e]/2}px;
        margin-left: 1px; // A little finicky, but the ANTD icon is not perfectly centered and the Figma icon is.
      }

      // Hover State
      &:active .ant-checkbox-inner {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
      }

      &:hover .ant-checkbox-inner {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
      }

      .ant-checkbox-wrapper:hover .ant-checkbox-inner {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
      }

      .ant-checkbox-wrapper:hover::selection {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
      }

      .ant-checkbox:hover .ant-checkbox-inner {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
      }

      .ant-checkbox:hover::after,
      .ant-checkbox-wrapper:hover .ant-checkbox::after {
        visibility: visible;
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
        border-radius: 4px;
      }

      // Focus State
      &:focus .ant-checkbox-inner,
      &:focus-within .ant-checkbox-inner {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
        border: none;
        box-shadow: 0px 0px 0px 4px rgba(217, 220, 255, 1);
      }
      &:focus-within .ant-checkbox-checked .ant-checkbox-inner {
        background-color: ${({theme:t})=>t.backgroundColor};
        &::after {
          border-color: ${Te.white};
        }
      }

      // Disabled State
      .ant-checkbox-disabled .ant-checkbox-inner {
        outline: 1px solid ${Te.gray200};
        &:hover {
          outline: 1px solid ${Te.gray200};
        }
        &::after {
          border-color: ${Te.gray200};
        }
      }

      // Indeterminate State
      .ant-checkbox-indeterminate .ant-checkbox-inner {
        outline: 2px solid ${({theme:t})=>t.backgroundColor};
      }
      .ant-checkbox-indeterminate .ant-checkbox-inner::after {
        height: 2px;
        width: 60%; // Icon grows with the checkbox.
        border-color: ${({theme:t})=>t.backgroundColor};
        background-color: ${({theme:t})=>t.backgroundColor};
      }
      .ant-checkbox-indeterminate .ant-checkbox-inner::after {
        margin: 0; // Undoing the margin-left of 1px added when the icon is a checkmark.
      }
    `}
